{
  "sourceLanguage": "en",
  "strings": {
    "%@Starting the download on %@, this takes about 10 seconds.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@Starte den Download auf %2$@, das dauert etwa 10 Sekunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@Starting the download on %@, this takes about 10 seconds."
          }
        }
      }
    },
    "Added to Drift": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu Drift hinzugefügt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added to Drift"
          }
        }
      }
    },
    "Adding to Drift…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird zu Drift hinzugefügt…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding to Drift…"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "No YouTube or YouTube Music link found.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Link von YouTube oder YouTube Music gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No YouTube or YouTube Music link found."
          }
        }
      }
    },
    "Not Added": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht hinzugefügt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Added"
          }
        }
      }
    },
    "Open Drift once with your server account, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Drift einmal mit deinem Server-Account und versuche es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Drift once with your server account, then try again."
          }
        }
      }
    },
    "The server answered with status %lld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat mit Status %lld geantwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server answered with status %lld."
          }
        }
      }
    },
    "The server did not start the download.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat den Download nicht gestartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server did not start the download."
          }
        }
      }
    },
    "The song will appear in your library in a minute.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Song erscheint in einer Minute in deiner Bibliothek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The song will appear in your library in a minute."
          }
        }
      }
    },
    "Adding Album to Drift…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Album wird zu Drift hinzugefügt…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding Album to Drift…"
          }
        }
      }
    },
    "Album Added to Drift": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Album zu Drift hinzugefügt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Album Added to Drift"
          }
        }
      }
    },
    "Album Already in Drift": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Album schon in Drift"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Album Already in Drift"
          }
        }
      }
    },
    "Starting the album download on %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Album-Download auf %@ wird gestartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting the album download on %@."
          }
        }
      }
    },
    "%@All songs are already in your library.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@Alle Songs sind schon in deiner Sammlung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@All songs are already in your library."
          }
        }
      }
    },
    "%@%lld songs are downloading, they appear in your library one by one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@%2$lld Songs werden geladen und erscheinen nach und nach in deiner Sammlung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@%2$lld songs are downloading, they appear in your library one by one."
          }
        }
      }
    },
    "%@%lld songs are downloading, %lld were already there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@%2$lld Songs werden geladen, %3$lld waren schon da."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@%2$lld songs are downloading, %3$lld were already there."
          }
        }
      }
    },
    "YouTube Music doesn't know this album, or it isn't reachable right now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube Music kennt dieses Album nicht oder ist gerade nicht erreichbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube Music doesn't know this album, or it isn't reachable right now."
          }
        }
      }
    },
    "YouTube Music isn't reachable right now. Try again later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube Music ist gerade nicht erreichbar. Versuch es später noch mal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube Music isn't reachable right now. Try again later."
          }
        }
      }
    }
  },
  "version": "1.0"
}
